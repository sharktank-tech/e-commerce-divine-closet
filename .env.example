# === Banco de dados ===
DATABASE_URL="postgresql://divine:divine@localhost:5432/divine_closet?schema=public"

# === Auth ===
# Gere um segredo forte: openssl rand -base64 48
JWT_SECRET="dev-secret-troque-em-producao-divine-closet-0123456789"
JWT_EXPIRES_HOURS="72"
ADMIN_JWT_EXPIRES_HOURS="12"

# === App ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Divine Closet"

# === Upload (dev: local | prod: s3) ===
UPLOAD_DRIVER="local"
UPLOAD_DIR="public/uploads"
# S3 / MinIO (produção)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="divine-closet"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# === Pagamento (mock até gateway real) ===
PAYMENT_DRIVER="mock"

# === E-mail (mock loga no console até SMTP) ===
EMAIL_DRIVER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Divine Closet <no-reply@divinecloset.com>"
