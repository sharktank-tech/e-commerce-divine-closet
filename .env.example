# === Banco de dados ===
DATABASE_URL="postgresql://divine:divine@localhost:5432/divine_closet?schema=public"

# === Auth ===
# Gere um segredo forte: openssl rand -base64 48
JWT_SECRET="dev-secret-troque-em-producao-divine-closet-0123456789"
JWT_EXPIRES_HOURS="72"
ADMIN_JWT_EXPIRES_HOURS="12"

# === App ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Divine Closet"

# === Upload (dev: local | prod: s3) ===
UPLOAD_DRIVER="local"
UPLOAD_DIR="public/uploads"
# S3 / MinIO (produção)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="divine-closet"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# === Pagamento (mock até gateway real) ===
PAYMENT_DRIVER="mock"
# Mercado Pago (Checkout Transparente: Pix + cartão via token).
# Sem MP_ACCESS_TOKEN, o driver "mercadopago" falha explícito; o padrão é mock.
#MP_ACCESS_TOKEN=""
# Chave pública (front, tokenização do cartão — próxima etapa).
#MP_PUBLIC_KEY=""
# Segredo do webhook (painel MP → https://<app>/api/pagamentos/webhook).
#MP_WEBHOOK_SECRET=""
# TTL do cache de cupons ilimitados em ms (padrão 300000 = 5 min).
#CUPOM_CACHE_TTL_MS="300000"

# === E-mail (mock | smtp | resend) ===
EMAIL_DRIVER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="Divine Closet <no-reply@divinecloset.com.br>"

# === Cron pós-compra (convite de avaliação) ===
CRON_SECRET=""
REVIEW_REQUEST_DAYS="7"

# === Seed: admin oficial (preencher no .env.local, fora do repositório) ===
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
