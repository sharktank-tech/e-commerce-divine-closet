generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  OPERATOR
  MARKETING
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PIX
  BOLETO
}

enum CategoryStatus {
  ACTIVE
  HIDDEN
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum BannerStatus {
  ACTIVE
  HIDDEN
}

model User {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String    @unique
  password             String
  name                 String
  phone                String?
  role                 Role      @default(CLIENT)
  active               Boolean   @default(true)
  provider             String? // null = credencial; estrutura p/ login social (desativado)
  socialId             String?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart?
  wishlist  WishlistItem[]

  @@index([email])
  @@index([role])
}

model Address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String   @default("Principal")
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  country      String   @default("BR")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  orders Order[]
}

model Category {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @unique
  slug        String         @unique
  description String?
  parentId    String?        @db.Uuid
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryTree")
  status      CategoryStatus @default(ACTIVE)
  menuOrder   Int            @default(0)
  showInMenu  Boolean        @default(true)
  showInHome  Boolean        @default(true)
  image       String?
  sizeTableId String?        @db.Uuid
  sizeTable   SizeTable?     @relation("CategoriaMedidas", fields: [sizeTableId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  products Product[]
}

model Product {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String     @unique
  description       String
  composicao        String?
  instrucoesLavagem String?
  comprimento       String?
  modeloAltura      String?
  modeloVeste       String?
  caimento          String?
  ocasiao           String?
  metaTitle         String?
  metaDescription   String?
  price             Decimal    @db.Decimal(10, 2)
  comparePrice      Decimal?   @db.Decimal(10, 2)
  discountPercent   Int        @default(0)
  sku               String?    @unique
  stock             Int        @default(0)
  isActive          Boolean    @default(true)
  featured          Boolean    @default(false)
  images            String[]
  imageColors       String[]   @default([])
  imageAlts         String[]   @default([])
  sizes             String[]
  colors            String[]
  categoryId        String     @db.Uuid
  category          Category   @relation(fields: [categoryId], references: [id])
  tabelaMedidasId   String?    @db.Uuid
  tabelaMedidas     SizeTable? @relation("ProdutoMedidas", fields: [tabelaMedidasId], references: [id])
  relacionados      String[]   @default([])

  lote_id           String?    @db.Uuid
  custo_peca_centavos Int       @default(0)
  custo_embalagem_centavos Int      @default(0)
  custos_extras_centavos Int       @default(0)
  custos_extras_descricao    String?
  markup_percentual        Int?
  preco_sugerido_centavos  Int?
  precificacao_calculada_em DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  orderItems   OrderItem[]
  reviews      Review[]
  cartItems    CartItem[]
  variations   ProductVariation[]
  wishlistedBy WishlistItem[]

  @@index([categoryId])
  @@index([isActive, featured])
  @@index([discountPercent])
  @@index([deletedAt])
}

model ProductVariation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String?
  stock     Int      @default(0)
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
}

model WishlistItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @unique @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId    String?  @unique
  couponCode String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  items CartItem[]
}

model CartItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String  @db.Uuid
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  size      String?
  color     String?

  @@unique([cartId, productId, size, color])
}

model Order {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number        String        @unique
  userId        String?       @db.Uuid
  user          User?         @relation(fields: [userId], references: [id])
  guestEmail    String?
  guestName     String?
  addressId     String?       @db.Uuid
  address       Address?      @relation(fields: [addressId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CARD)
  paymentId     String?
  couponCode    String?
  subtotal      Decimal       @db.Decimal(10, 2)
  shipping      Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?
  trackingCode  String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  items             OrderItem[]
  reviews           Review[]
  reviewRequestedAt DateTime?
  entregueEm        DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id])
  productName String
  productSlug String
  imageUrl    String?
  size        String?
  color       String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
}

model Review {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String        @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId         String        @db.Uuid
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating          Int
  titulo          String?
  comment         String
  tamanhoComprado String?
  caimento        String?
  alturaCliente   String?
  status          ReviewStatus  @default(PENDENTE)
  respostaLoja    String?
  fotos           ReviewPhoto[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@unique([orderId, productId])
  @@index([productId, status])
}

model ReviewPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String   @db.Uuid
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
}

enum ReviewStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

model Coupon {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minSubtotal Decimal?   @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int        @default(0)
  active      Boolean    @default(true)
  startsAt    DateTime   @default(now())
  endsAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
}

model Banner {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  Int          @default(0)
  status    BannerStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model SlugRedirect {
  oldSlug   String   @id
  newSlug   String
  createdAt DateTime @default(now())
}

model SizeTable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  unit      String   @default("cm")
  columns   Json     @default("[]")
  rows      Json     @default("[]")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]  @relation("ProdutoMedidas")
  categories Category[] @relation("CategoriaMedidas")
}

model LoteCompra {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String     @unique
  data_compra      DateTime   @db.Date
  valor_mercadoria_centavos Int       @default(0)
  valor_frete_centavos      Int       @default(0)
  quantidade_pecas    Int       @default(1)
  categoria_id      String?    @db.Uuid
  observacoes       String?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  @@map("lotes_compra")
}

model ConfigPrecificacao {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  markup_padrao_percentual    Int       @default(100)
  regra_arredondamento_custo  String    @default("inteiro_para_cima")
  regra_final_preco           String    @default("termina_99")
  rateio_frete                String    @default("igual")
  embalagem_entra_no_markup   Boolean   @default(true)
  margem_minima_percentual    Int?
  taxa_pagamento_percentual   Int?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  @@map("config_precificacao")
}

model MateriaisEmbalagem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String     @unique
  custo_unitario_centavos Int       @default(0)
  ativo       Boolean    @default(true)
  ordem       Int        @default(0)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@map("materiais_embalagem")
}
