generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  OPERATOR
  MARKETING
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PIX
  BOLETO
}

enum CategoryStatus {
  ACTIVE
  HIDDEN
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum BannerStatus {
  ACTIVE
  HIDDEN
}

model User {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String    @unique
  password             String
  name                 String
  phone                String?
  role                 Role      @default(CLIENT)
  active               Boolean   @default(true)
  provider             String? // null = credencial; estrutura p/ login social (desativado)
  socialId             String?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart?
  wishlist  WishlistItem[]
  historicoPreco HistoricoPreco[]

  @@index([email])
  @@index([role])
}

model Address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String   @default("Principal")
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  country      String   @default("BR")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  orders Order[]
}

model Category {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @unique
  slug        String         @unique
  description String?
  parentId    String?        @db.Uuid
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryTree")
  status      CategoryStatus @default(ACTIVE)
  menuOrder   Int            @default(0)
  showInMenu  Boolean        @default(true)
  showInHome  Boolean        @default(true)
  image       String?
  sizeTableId String?        @db.Uuid
  sizeTable   SizeTable?     @relation("CategoriaMedidas", fields: [sizeTableId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  products Product[]
}

model Product {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String     @unique
  description       String
  composicao        String?
  instrucoesLavagem String?
  comprimento       String?
  modeloAltura      String?
  modeloVeste       String?
  caimento          String?
  ocasiao           String?
  metaTitle         String?
  metaDescription   String?
  price             Decimal    @db.Decimal(10, 2)
  comparePrice      Decimal?   @db.Decimal(10, 2)
  discountPercent   Int        @default(0)
  sku               String?    @unique
  stock             Int        @default(0)
  isActive          Boolean    @default(true)
  featured          Boolean    @default(false)
  images            String[]
  imageColors       String[]   @default([])
  imageAlts         String[]   @default([])
  sizes             String[]
  colors            String[]
  categoryId        String     @db.Uuid
  category          Category   @relation(fields: [categoryId], references: [id])
  tabelaMedidasId   String?    @db.Uuid
  tabelaMedidas     SizeTable? @relation("ProdutoMedidas", fields: [tabelaMedidasId], references: [id])
  relacionados      String[]   @default([])

  lote_id           String?    @db.Uuid
  custo_peca_centavos Int       @default(0)
  custo_embalagem_centavos Int      @default(0)
  custos_extras_centavos Int       @default(0)
  custos_extras_descricao    String?
  markup_percentual        Int?
  preco_sugerido_centavos  Int?
  precificacao_calculada_em DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  orderItems   OrderItem[]
  reviews      Review[]
  cartItems    CartItem[]
  variations   ProductVariation[]
  wishlistedBy WishlistItem[]
  historicoPreco HistoricoPreco[]

  @@index([categoryId])
  @@index([isActive, featured])
  @@index([discountPercent])
  @@index([deletedAt])
}

model ProductVariation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String?
  stock     Int      @default(0)
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
}

model WishlistItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @unique @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId    String?  @unique
  couponCode String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  // Lembrete de abandono enviado em (null = nunca) — item 1 pós-Fase 3.
  lembradoEm DateTime?

  items CartItem[]
}

model CartItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String  @db.Uuid
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  size      String?
  color     String?
  createdAt DateTime @default(now())

  @@unique([cartId, productId, size, color])
}


enum ErpEventStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

// Fila persistente de eventos loja → ERP. A PK é o event_id do envelope e
// businessKey é a OCORRÊNCIA de negócio (ex.: pedido_estornado:{orderId}) —
// reprocesso/concorrência não duplica evento (P2002 idempotente). Gravado
// SEMPRE (mesmo com ERP desativado: fila guarda o histórico e a entrega
// acontece quando houver URL+segredo; dreno no cron com backoff exponencial,
// DEAD após esgotar tentativas). Payload nunca sai daqui sem assinatura.
model ErpEvent {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // = event_id do envelope (app envia; default p/ inserts sem id)
  businessKey    String?        @unique // ocorrência de negócio; null = evento livrístico (estoque/edições)
  version        Int            @default(1)
  tipo           String
  payload        Json
  status         ErpEventStatus @default(PENDING)
  attempt        Int            @default(0)
  nextAttemptAt  DateTime       @default(now())
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, nextAttemptAt])
}

model Order {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number        String        @unique
  userId        String?       @db.Uuid
  user          User?         @relation(fields: [userId], references: [id])
  guestEmail    String?
  guestName     String?
  addressId     String?       @db.Uuid
  address       Address?      @relation(fields: [addressId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CARD)
  paymentId     String?
  // Chave de idempotência do CHECKOUT: o cliente (ou o front) gera uma chave
  // estável por tentativa de compra e a repete no retry. O índice único
  // transforma a corrida "duas requisições do mesmo checkout" em P2002, que a
  // rota devolve como o MESMO pedido — nunca dois pedidos nem duas cobranças.
  // null = pedidos anteriores ao recurso (não há backfill).
  idempotencyKey String?   @unique
  couponCode    String?
  subtotal      Decimal       @db.Decimal(10, 2)
  shipping      Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?
  trackingCode     String?
  trackingCarrier String?
  trackingUrl      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  items             OrderItem[]
  refund            Refund?
  trackToken        OrderTrackToken?
  reviews           Review[]
  reviewRequestedAt DateTime?
  entregueEm        DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}


enum RefundStatus {
  REQUESTED
  IN_PROCESS
  APPROVED
  REJECTED
}

// Estorno integral de um pedido via Mercado Pago (1:1 — só um estorno por
// pedido). status muda SOMENTE com confirmação real do provedor:
// REQUESTED = chamada ao MP em curso/incerta; IN_PROCESS = refund aceito,
// aguardando liquidação; APPROVED/REJECTED = resolvido. O pedido só vira
// REFUNDED após APPROVED (nunca apenas por tentativa).
model Refund {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @unique @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId      String
  amount         Decimal       @db.Decimal(10, 2)
  status         RefundStatus  @default(REQUESTED)
  mpRefundId     String?
  attempt        Int           @default(1)
  idempotencyKey String        @unique
  requestedBy    String?       @db.Uuid // admin que solicitou; null = sistema (reconciliação)
  requestedAt    DateTime      @default(now())
  resolvedAt     DateTime?
  lastError      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([paymentId])
}

// Link privado de acompanhamento para pedido de CONVIDADO (sem conta).
// Só o hash SHA-256 fica no banco — o plaintext viaja apenas no e-mail.
// Reenvio ROTACIONA o token: como `orderId` é único (1 linha/pedido), a
// rotação SOBRESCREVE o `tokenHash` e o link antigo morre sozinho — não há
// como 2 tokens ativos coexistirem. `revokedAt` é um gancho RESERVADO de
// revogação explícita sem rotação (lido por `tokenAtivo`, mas hoje sempre
// null; preenchê-lo negaria o acesso e a próxima rotação o limpa).
// Respeita limite (sendCount) + espera (lastSentAt) por pedido.
model OrderTrackToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String    @unique @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  sentTo      String?
  sendCount   Int       @default(0)
  lastSentAt  DateTime?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}

model OrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  productSlug String
  imageUrl    String?
  size        String?
  color       String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
}

model Review {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String        @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId         String        @db.Uuid
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating          Int
  titulo          String?
  comment         String
  tamanhoComprado String?
  caimento        String?
  alturaCliente   String?
  status          ReviewStatus  @default(PENDENTE)
  respostaLoja    String?
  fotos           ReviewPhoto[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@unique([orderId, productId])
  @@index([productId, status])
}

model ReviewPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String   @db.Uuid
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
}

enum ReviewStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

model Coupon {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minSubtotal Decimal?   @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int        @default(0)
  active      Boolean    @default(true)
  startsAt    DateTime   @default(now())
  endsAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
}

model Banner {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  Int          @default(0)
  status    BannerStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model SlugRedirect {
  oldSlug   String   @id
  newSlug   String
  createdAt DateTime @default(now())
}

model SizeTable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  unit      String   @default("cm")
  columns   Json     @default("[]")
  rows      Json     @default("[]")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]  @relation("ProdutoMedidas")
  categories Category[] @relation("CategoriaMedidas")
}

model LoteCompra {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String     @unique
  data_compra      DateTime   @db.Date
  valor_mercadoria_centavos Int       @default(0)
  valor_frete_centavos      Int       @default(0)
  quantidade_pecas    Int       @default(1)
  categoria_id      String?    @db.Uuid
  observacoes       String?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  @@map("lotes_compra")
}

model ConfigPrecificacao {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  markup_padrao_percentual    Int       @default(100)
  regra_arredondamento_custo  String    @default("inteiro_para_cima")
  regra_final_preco           String    @default("termina_99")
  rateio_frete                String    @default("igual")
  embalagem_entra_no_markup   Boolean   @default(true)
  margem_minima_percentual    Int?
  taxa_pagamento_percentual   Int?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  @@map("config_precificacao")
}

model MateriaisEmbalagem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String     @unique
  custo_unitario_centavos Int       @default(0)
  ativo       Boolean    @default(true)
  ordem       Int        @default(0)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@map("materiais_embalagem")
}

// Auditoria de preço: uma linha por mudança de Product.price.
// origem: edicao_manual | recalculo_massa | import_csv
// (import registra a criação com anterior = 0).
model HistoricoPreco {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produto_id              String    @db.Uuid
  produto                 Product   @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  usuario_id              String?   @db.Uuid
  usuario                 User?     @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  preco_anterior_centavos Int
  preco_novo_centavos     Int
  origem                  String
  criado_em               DateTime  @default(now())

  @@index([produto_id, criado_em])
  @@map("historico_preco")
}

// Contador de tentativas por chave (ex.: reenviar:ip:203.0.113.9) em janelas
// fixas — rate-limit do reenvio de link guest, persistido em Postgres para
// valer entre instâncias serverless. Janela = início arredondado; linhas
// antigas são simplesmente ignoradas (nenhuma limpeza necessária).
model RateLimit {
  chave        String   @db.VarChar(120)
  janelaInicio DateTime
  total        Int      @default(1)
  createdAt    DateTime @default(now())

  @@id([chave, janelaInicio])
}

// Outbox de e-mail transacional com retentativa persistente (estorno e demais
// status). Payload renderizado UMA vez na enfileiração (imutável → o Resend
// deduplica pelo header Idempotency-Key, janela de 24h — ver
// EMAIL-ESTORNO-RETENTATIVA.md). SENT = aceito pelo provedor (nunca antes);
// FAILED = falha definitiva (configuração/validação ou tentativas esgotadas).
// orderId sem FK de propósito (mesmo critério de auditoria do ErpEvent).
enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey     String           @unique
  kind          String
  orderId       String?          @db.Uuid
  recipient     String
  subject       String
  text          String?
  html          String?
  status        EmailOutboxStatus @default(PENDING)
  attempt       Int              @default(0)
  nextAttemptAt DateTime         @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, nextAttemptAt])
}
